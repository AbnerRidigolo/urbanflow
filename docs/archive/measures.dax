Viagens = SUM(fct_hourly[trips])
Valor USD = SUM(fct_hourly[total_usd])
Duração média min = DIVIDE(SUM(fct_hourly[duration_minutes]), [Viagens])
Real avaliado = SUM(predictions[trips])
Previsto = SUM(predictions[prediction])
Baseline = SUM(predictions[baseline])
MAE modelo = AVERAGEX(predictions, ABS(predictions[trips] - predictions[prediction]))
MAE baseline = AVERAGEX(predictions, ABS(predictions[trips] - predictions[baseline]))
WAPE modelo = DIVIDE(SUMX(predictions, ABS(predictions[trips] - predictions[prediction])), SUMX(predictions, ABS(predictions[trips])))
WAPE baseline = DIVIDE(SUMX(predictions, ABS(predictions[trips] - predictions[baseline])), SUMX(predictions, ABS(predictions[trips])))
